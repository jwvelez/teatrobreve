# API key del box office de Ticket Tailor (Settings > API)
TICKET_TAILOR_API_KEY=

# Secret del webhook — DÉJALO VACÍO: el dashboard de Ticket Tailor no expone
# ningún signing secret. El receptor descubre solo si llega header de firma y,
# si llega, prueba el API key como secreto HMAC. El resultado queda en V7.
TT_WEBHOOK_SECRET=

# Puerto local
PORT=3000
